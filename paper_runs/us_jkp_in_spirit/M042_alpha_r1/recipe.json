  "primary_source_anchors": [
    {
      "anchor": "Sections 3.1-3.3 and Figure 1",
      "mechanism": "Historical market memory and factor performance become semantic factor profiles; current price/news state is matched to those profiles to activate a sparse factor subset."
    },
    {
      "anchor": "Section 3.4 and Equations 5-11",
      "mechanism": "A fixed historical linear scorer turns active factor values into expected returns, while group-relative reinforcement learning rewards market performance and disciplined selections."
    },
    {
      "anchor": "Section 3.5 and Equation 12",
      "mechanism": "Selected-factor scores rank stocks for a top-N portfolio, with slot rotation, VWAP execution, constraints, and bilateral 10 bp costs."
    },
    {
      "anchor": "Section 4.1",
      "mechanism": "The native test uses a fixed 40-factor candidate set drawn from 82 retained Alpha101 factors, four years for beta estimation, and deterministic inference."
    }
  ],
